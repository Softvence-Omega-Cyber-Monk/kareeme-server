model GlobalSettings {
  id String @id @default(uuid())

  emailNotificationsOn Boolean @default(true)
  smsNotificationsOn   Boolean @default(false)
  pushNotificationsOn  Boolean @default(false)

  tfaOn            Boolean @default(false)
  passwordPolicyOn Boolean @default(false)

  ipBlockList String[] @default([])

  autoDistributionOn Boolean @default(true)

  defaultDistributionPlatforms DistributionPlatform[] @default([All])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("global_settings")
}

model ClientSettings {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  defaultDistributionPlatforms DistributionPlatform[] @default([All])
  defaultGenres                String[]               @default([])
  distributionTerritories      String[]               @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("client_settings")
}
