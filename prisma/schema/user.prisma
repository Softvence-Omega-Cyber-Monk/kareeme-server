model User {
  id String @id @default(uuid())

  // Identity
  name     String  @default("Unnamed User")
  email    String  @unique
  password String? // hashed password
  phone    String? @unique

  // Settings
  role   UserRole   @default(CLIENT)
  status UserStatus @default(ACTIVE)

  isVerified   Boolean @default(false)
  isTFAEnabled Boolean @default(false)

  // Activity
  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  // Avatar
  profilePictureUrl String?
  profilePictureId  String?
  profilePicture    FileInstance? @relation(fields: [profilePictureId], references: [id], onDelete: SetNull)

  // Notifications Relations
  notifications        UserNotification[]
  notificationSettings NotificationSettings[]

  // Auth Relations
  otps          UserOtp[]
  refreshTokens RefreshToken[]

  // Settings Relations
  clientSettings ClientSettings[]
  loginDevices   LoginDevice[]
  releases       Release[]

  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  artists                  Artist[]
  statements               Statement[]
  transactions             Transaction[]
  dealStatuses             DealStatus[]
  paymentRequests          PaymentRequest[]
  platformAnalytics        PlatformAnalytics[]
  assets                   Asset[]
  geoTrends                GeoTrend[]
  claims                   Claim[]
  paymentMethods           PaymentMethod[]
  privacySettings          PrivacySettings?
  distributorClients       DistributorClient[]   @relation("DistributorClients")
  distributorCatalogues    ClientBackCatalogue[] @relation("DistributorCatalogues")
  distributorDistributions Distribution[]        @relation("DistributorDistributions")
  clientDistributions      Distribution[]        @relation("ClientDistributions")
  distributionNotes        DistributionNote[]
  teamMember               TeamMember[]
  accountantSettings       AccountantSettings?
  platformEarnings         PlatformEarning[]
  pendingPayments          PendingPayment[]
  paymentHistory           PaymentHistory[]
  clientFinancials         ClientFinancial[]
  monthlyStatements        MonthlyStatement[]

  clientDistributor DistributorClient[]   @relation("ClientDistributor")
  clientCatalogues  ClientBackCatalogue[] @relation("ClientCatalogues")
  cart              Cart?
  orders            Order[]

  @@map("users")
}

enum UserRole {
  // System
  SUPER_ADMIN

  // Added by Super Admin (Each can be multiple)
  ADMIN
  DISTRIBUTOR
  ACCOUNTANT

  // Clients
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}
