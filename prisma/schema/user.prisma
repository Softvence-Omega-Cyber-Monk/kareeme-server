model User {
  id String @id @default(uuid())

  // Identity
  name     String @default("Unnamed User")
  email    String @unique
  password String // hashed password
  phone    String? @unique

  // Settings
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)

  // // From Clients 
  // defaultDistributionPlatforms String[]
  // defaultGenres                String[]
  // distributionTerritories      String[]

  // // From Admin
  // givenAccess String[] @default([])

  // Activity
  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  // Avatar
  profilePictureUrl String?
  profilePictureId  String?
  profilePicture    FileInstance? @relation(fields: [profilePictureId], references: [id], onDelete: SetNull)

  // Notifications Relations
  notifications UserNotification[]
  notificationSettings NotificationSettings[]
  
  // Auth Relations
  otps          UserOtp[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  CLIENT
  DISTRIBUTOR
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}
