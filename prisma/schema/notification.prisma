model Notification {
  id String @id @default(uuid())

  type    String
  title   String
  message String

  // Use JSON to store metadata
  meta Json

  users UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("notifications")
}

model UserNotification {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  read Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, notificationId])
  @@map("user_notifications")
}

model NotificationSettings {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Clients only can customize these settings
  isNewReleaseAlertsOn Boolean @default(true)
  isEarningAlertsOn    Boolean @default(true)
  isPlatformUpdatesOn  Boolean @default(true)

  // Toggles for specific channels
  emailNotificationsOn Boolean @default(true)
  smsNotificationsOn   Boolean @default(true)
  pushNotificationsOn  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("notification_settings")
}
