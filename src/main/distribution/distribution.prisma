// ========== Distribution Models ==========

enum DistributionStatus {
  Pending
  InProgress
  Distributed
  Failed
  Declined
}

enum ClientRole {
  Artist
  Label
  Manager
  Producer
}

model Distribution {
  distributionId     String              @id @default(uuid()) @map("distribution_id")
  releaseId          String              @map("release_id")
  userId             String              @map("user_id") // Artist/Client who owns the release
  distributorId      String              @map("distributor_id") // Distributor handling this
  
  // Distribution Info
  status             DistributionStatus  @default(Pending)
  submittedAt        DateTime            @default(now()) @map("submitted_at")
  approvedAt         DateTime?           @map("approved_at")
  distributedAt      DateTime?           @map("distributed_at")
  declinedAt         DateTime?           @map("declined_at")
  
  // Platform statuses
  platformStatuses   PlatformDistribution[]
  notes              DistributionNote[]
  
  // Relations
  release            Release             @relation(fields: [releaseId], references: [releaseId], onDelete: Cascade)
  user               User                @relation("ClientDistributions", fields: [userId], references: [id], onDelete: Cascade)
  distributor        User                @relation("DistributorDistributions", fields: [distributorId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  
  @@index([distributorId, status])
  @@index([userId, status])
  @@index([releaseId])
  @@map("distributions")
}

model PlatformDistribution {
  platformDistId     String              @id @default(uuid()) @map("platform_dist_id")
  distributionId     String              @map("distribution_id")
  
  platform           String              @db.VarChar // YouTube, Spotify, Apple Music, etc.
  status             DistributionStatus  @default(Pending)
  
  // Platform-specific data
  platformReleaseId  String?             @map("platform_release_id") @db.VarChar
  platformUrl        String?             @map("platform_url") @db.VarChar
  
  // Stats
  streams            Int                 @default(0)
  
  // Timestamps
  sentAt             DateTime?           @map("sent_at")
  liveAt             DateTime?           @map("live_at")
  failedAt           DateTime?           @map("failed_at")
  errorMessage       String?             @map("error_message") @db.Text
  
  // Relations
  distribution       Distribution        @relation(fields: [distributionId], references: [distributionId], onDelete: Cascade)
  
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  
  @@index([distributionId])
  @@index([platform, status])
  @@map("platform_distributions")
}

model DistributionNote {
  noteId             String              @id @default(uuid()) @map("note_id")
  distributionId     String              @map("distribution_id")
  userId             String              @map("user_id")
  
  content            String              @db.Text
  isInternal         Boolean             @default(false) @map("is_internal") // Only visible to distributor
  
  // Relations
  distribution       Distribution        @relation(fields: [distributionId], references: [distributionId], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  
  @@index([distributionId])
  @@map("distribution_notes")
}

model DistributorClient {
  clientId           String              @id @default(uuid()) @map("client_id")
  distributorId      String              @map("distributor_id")
  userId             String              @map("user_id")
  
  // Client Info
  role               ClientRole          @default(Artist)
  phoneNumber        String?             @map("phone_number") @db.VarChar
  
  // Stats
  totalReleases      Int                 @default(0) @map("total_releases")
  
  // Status
  isActive           Boolean             @default(true) @map("is_active")
  
  // OTP for client login
  oneTimePassword    String?             @map("one_time_password") @db.VarChar
  otpExpiresAt       DateTime?           @map("otp_expires_at")
  
  // Relations
  distributor        User                @relation("DistributorClients", fields: [distributorId], references: [id], onDelete: Cascade)
  user               User                @relation("ClientDistributor", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  
  @@unique([distributorId, userId])
  @@index([distributorId, isActive])
  @@index([userId])
  @@map("distributor_clients")
}

model ClientBackCatalogue {
  catalogueId        String              @id @default(uuid()) @map("catalogue_id")
  distributorId      String              @map("distributor_id")
  userId             String              @map("user_id") // Artist/Client
  
  // Artist Info
  artistName         String              @map("artist_name") @db.VarChar
  genre              String?             @db.VarChar
  
  // Release summary
  totalReleases      Int                 @default(0) @map("total_releases")
  releaseTypes       String?             @map("release_types") @db.VarChar // "3 Albums, 2 Single"
  
  // Distribution info
  currentDistributor String?             @map("current_distributor") @db.VarChar
  label              String?             @db.VarChar
  totalTracks        Int                 @default(0) @map("total_tracks")
  
  // Date range
  dateRangeStart     DateTime?           @map("date_range_start") @db.Date
  dateRangeEnd       DateTime?           @map("date_range_end") @db.Date
  
  // Relations
  distributor        User                @relation("DistributorCatalogues", fields: [distributorId], references: [id], onDelete: Cascade)
  user               User                @relation("ClientCatalogues", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  
  @@index([distributorId])
  @@index([userId])
  @@map("client_back_catalogues")
}

